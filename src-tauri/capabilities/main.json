{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Profile and storage access from the bundled main window",
  "windows": ["main"],
  "permissions": [
    "allow-get-snapshot",
    "allow-get-game",
    "allow-start-game",
    "allow-stop-game",
    "allow-get-auth",
    "allow-login",
    "allow-logout",
    "allow-continue-login",
    "allow-cancel-login",
    "allow-refresh-auth",
    "allow-restore-auth",
    "allow-get-workspace",
    "allow-create-profile",
    "allow-select-profile",
    "allow-save-profile",
    "allow-switch-data-root",
    "allow-start-install",
    "allow-get-installation",
    "allow-cancel-install",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
