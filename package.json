{
  "name": "minecraft-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "npm run dev --workspace @launcher/frontend",
    "build": "npm run build --workspace @launcher/frontend",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspace @launcher/frontend",
    "test": "npm run test --workspace @launcher/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check:release-guard": "python3 scripts/check-release-guard.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
